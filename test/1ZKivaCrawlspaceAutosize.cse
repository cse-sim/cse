// 1ZKivaCrawlspaceAutosize.cse
// Single-family house over a vented crawlspace modeled with Kiva, including below grade crawlspace walls, run with
// autosizing. Regression test for duplicate below grade walls on re-setup after autosizing, which caused "The weights
// of associated Kiva instances do not add to unity".
// Derived from a Modelkit-composed input (NEEA advanced heat pump study). Design conditions are for Boise, ID.

    runTitle = "Kiva crawlspace walls with autosizing"
    wfName = "CTZ12S13b.CSW"
    ebTolHour = 0.001
    ebTolDay = 0.001
    ebTolMon = 0.001
    ebTolSubHr = 0.001
    jan1DOW = "THU"
    skyModel = "anisotropic"
    bldgAzm = 0
    dt = "YES"
    nSubSteps = 10
    wuDays = 30
    awTrigSlr = 0.1
    anTolAbs = 0.005
    anTolRel = 0.0005
    doAutoSize = "YES"
    auszTol = 0.01
    awTrigT = 3
    awTrigH = 0.3
    DELETE REPORT "eb"
    DELETE REPORT "Inp"
METER   "Electric Meter"
METER   "Gas Meter"
heatDsTDbO = 2.6599999999999966
heatDsTWbO = 2.6599999999999966
